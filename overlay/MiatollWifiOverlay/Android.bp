runtime_resource_overlay {
    name: "MiatollWifiOverlay",
    manifest: "AndroidManifest.xml",
    device_specific: true,
    overrides: ["WifiResCommon_Sys"],
}

runtime_resource_overlay {
    name: "MiatollWifiMainlineOverlay",
    manifest: "AndroidManifestMainline.xml",
    device_specific: true,
    overrides: ["WifiResCommonMainline_Sys"],
}
